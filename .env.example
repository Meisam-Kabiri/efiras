# ==============================================
# EFIRAS Backend Environment Configuration
# ==============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git (it contains secrets)

# ----------------------------------------------
# OpenAI Configuration (for embeddings & RAG)
# ----------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
GPT_API_KEY=your_openai_api_key_here

# ----------------------------------------------
# Azure OpenAI Configuration (Alternative)
# ----------------------------------------------
# Use Azure OpenAI instead of standard OpenAI
# Get credentials from: https://portal.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# ----------------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------------
# Database for user tracking, analytics, and usage limits
PGHOST=your-server.postgres.database.azure.com
PGPORT=5432
PGDATABASE=efiras_db
PGUSER=efirasadmindb
PGPASSWORD=your_database_password_here

# ----------------------------------------------
# Application Configuration
# ----------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
# Production example: https://yourdomain.com,https://www.yourdomain.com
# Development: http://localhost:3000,http://localhost:8080
ALLOWED_ORIGINS=*

# Server port (optional, default: 8080)
PORT=8080

# ----------------------------------------------
# Firebase Configuration (for Authentication)
# ----------------------------------------------
# Place your Firebase service account JSON file in the secrets/ folder
# File path: secrets/firebase-service-account.json
# Download from: Firebase Console > Project Settings > Service Accounts

# ----------------------------------------------
# Optional: Azure AI Search (Enterprise Search)
# ----------------------------------------------
# For production-scale vector search
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key_here

# ----------------------------------------------
# Notes:
# ----------------------------------------------
# 1. At minimum, you need GPT_API_KEY and PostgreSQL credentials
# 2. Firebase credentials are required for authenticated endpoints
# 3. Azure services are optional alternatives/enhancements
# 4. Never commit this file with actual secrets to version control
# 5. Keep your .env file in .gitignore
